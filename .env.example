# Copy to .env. Leave RPC_WS_URL empty (or set DEMO=1) to run on synthetic launches.
# A Solana RPC websocket URL from a provider you sign up with (Helius, QuickNode, Triton...).
RPC_WS_URL=
# Approximate SOL price in USD, used to convert market cap and liquidity.
SOL_USD=73
# Dashboard port (served on 127.0.0.1 only).
PORT=3000
# DEMO=1 forces synthetic launches. DEMO_SPEED=5 runs the demo 5x faster.
DEMO=
DEMO_SPEED=1
